# VIOManager 论坛站环境变量样例（复制为 .env.development 使用；仓库仅入库本样例）
# 论坛服务接口地址：开发期留空走 vite 代理（vite.config 把 /api 转发到论坛服务 8089，同源免 CORS；
# 生产由 Nginx 同域分流，同样留空；指向独立部署的论坛服务时才填完整地址）
VITE_API_BASE_URL=
# 主站地址：论坛未登录时引导回主站登录（JWT 共享，论坛不单独设登录页）
VITE_MAIN_SITE_URL=http://localhost:5174/login
# 本地假数据开关：true=mock 层接管全部请求（不接后端）；false=走真实后端（联调时改这里）
VITE_USE_MOCK=true
