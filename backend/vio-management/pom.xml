<?xml version="1.0" encoding="UTF-8"?>
<!--
  vio-management 管理系统服务：阶段1 唯一可运行服务。
  Step 0 只含工程底座（web 容器 + 数据源 + Flyway 建表 + 健康检查）；
  MyBatis-Plus Step 2、JWT Step 3、MinIO Step 8、ClamAV Step 8 按步引入，不顺手前置。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.viomanager</groupId>
        <artifactId>vio-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vio-management</artifactId>
    <name>vio-management</name>
    <description>VIOManager 管理系统服务（阶段1）</description>

    <dependencies>
        <!-- 底座 jar：统一响应/异常、基座字段、幂等、审计自 Step 1 起落那里 -->
        <dependency>
            <groupId>com.viomanager</groupId>
            <artifactId>vio-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Flyway 迁移需要 DataSource；Step 2 引 MyBatis-Plus 时仍复用同款连接池 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ORM 基座：雪花 ID / 逻辑删除 / 审计字段填充 / 分页 / 乐观锁 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- 参数校验（@Valid 触发的异常由 common 全局处理器收敛为 1001） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP 运行期：幂等切面（Step 5）与审计切面（Step 6）的代理织入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Redis（Lettuce）：审批中心升级插入点①②的组织树/未读红点缓存。
             降级三件套与 kb 同款——1s 命令超时 + 代码内 30s 熔断，Redis 不可用时透明回退直查库；
             连接懒建立，本机没有 Redis 也不挡应用启动 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- RocketMQ 客户端（remoting 协议，连本机 5.5.0 broker）：插入点③④延迟消息与状态变更通知。
             默认零装配——rocketmq.name-server 未配置时 starter 不激活，任何 MQ Bean 都不建；
             版本锁定 2.3.6（本机 mvn_repo 已缓存，零下载） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.3.6</version>
        </dependency>

        <!-- Redisson 分布式锁（组队超卖修复，方案 §12.5）：只用核心包不用它的 starter——
             starter 会接管 spring.data.redis 连接工厂，与缓存的 Lettuce 冲突；
             客户端懒创建 + 30s 熔断（TeamLockSupport），Redis 未起不挡应用启动；
             版本锁定 3.27.2（本机 mvn_repo 已缓存，零下载） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>3.27.2</version>
        </dependency>

        <!-- MinIO 对象存储 SDK：Step 8 文件服务 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>

        <!-- BCrypt 密码加密：只取 crypto 模块，不引 Spring Security 全家桶（方案 §2 拍板） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>

        <!-- A07 获奖导出用（xlsx）；只引主包，xmlbeans 等传递依赖随包带入 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>

        <!-- 显式顶高 commons-compress：Spring Boot 3.5 管理的 1.24.0 会让 POI 5.4 在写 xlsx 时
             NoSuchMethodError（ZipArchiveOutputStream.putArchiveEntry），直依赖显式版本优先级最高 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.27.1</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
