<?xml version="1.0" encoding="UTF-8"?>
<!--
  Docker 镜像构建专用 Maven 配置：替换 maven 官方镜像内的全局 settings，
  让容器内依赖下载走阿里云（与宿主 D:/apache-maven-3.9.13/conf/settings.xml 同源）。
  只镜像 central：本项目依赖全部在 central 上（Spring Boot 3.5.5 已 GA），不引入额外仓库。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <!-- 2026-10-18：阿里云源下载大 jar（grpc-netty-shaded 9.3MB）多次传一半被掐断
         （Premature end of Content-Length），换腾讯源；宿主 settings 同步改 -->
    <mirror>
      <id>tencentmaven</id>
      <mirrorOf>central</mirrorOf>
      <name>tencent maven</name>
      <url>https://mirrors.cloud.tencent.com/nexus/repository/maven-public/</url>
    </mirror>
  </mirrors>
</settings>
