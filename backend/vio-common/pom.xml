<?xml version="1.0" encoding="UTF-8"?>
<!--
  vio-common 底座 jar：无业务、无数据库，只放骨架公共组件。
  Step 1 统一响应异常、Step 2 基座字段、Step 5 幂等、Step 6 审计的实现落本模块，
  阶段2 论坛服务直接复用同一 jar。
  ⚠️ 冲突：本模块是独立版本化的骨架专属领地，只有骨架负责人能改，业务代码禁止进入；
  它不是被否掉的"全局包"（骨架方案 §2.1）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.viomanager</groupId>
        <artifactId>vio-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vio-common</artifactId>
    <name>vio-common</name>
    <description>骨架公共底座：跨服务复用的非业务组件</description>
</project>
