# VIOManager 部署环境变量模板：复制为 backend/.env 后逐项填自己的值
#（.env 已被 .gitignore 排除，密钥不入库；完整变量说明见 docs/部署与使用指南.md）。
# 不建 .env 时容器以 compose 内置的本地开发默认值启动——只适合本机试用，
# 学校服务器/生产环境必须建 .env 并自拟全部口令。

# ---------- 数据库 ----------
# MySQL root 口令：自拟强口令（mysql 容器与应用容器共用此值）
MYSQL_ROOT_PASSWORD=<自拟强口令>
MYSQL_DATABASE=viomanager
# 宿主机映射端口（本机 3307 被其他库占用时才改）
MYSQL_PORT=3307

# ---------- 对象存储 MinIO ----------
MINIO_ROOT_USER=<自拟账号>
MINIO_ROOT_PASSWORD=<自拟强口令>

# ---------- 安全 ----------
# JWT 签名密钥：自拟随机串，长度 ≥ 32 字节（泄露 = 任何人可伪造登录态）
JWT_SECRET=<自拟随机串，至少32字节>

# ---------- 学校服务器部署建议设置 ----------
# 排除演示数据：默认（本地开发）会灌演示数据；学校服务器只保留部署引导基线
#（admin 账号/字典底座/系统参数，admin 初始口令见部署指南，首登强制改密）
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# ---------- AI 助手（可选：不配 = 零装配照常跑） ----------
# 模型接入三件套；GLM_API_KEY 只活在环境变量，绝不写进任何文件
GLM_BASE_URL=<模型服务地址，如 http://宿主机:11434/v1>
GLM_MODEL=<模型名，如 qwen2.5:7b>
GLM_API_KEY=<密钥，本地 Ollama 填任意占位值>
# 本地 Ollama 服务地址（embedding 与对话模型共用）
OLLAMA_BASE_URL=<Ollama 地址，如 http://宿主机:11434>
