# 本地开发环境变量样例：复制为 backend/.env 后按需修改（.env 已被 .gitignore 排除，密钥不入库）。
# 不建 .env 时各容器用 docker-compose.yml 内置默认值，开箱即用。

# MySQL（本地开发默认值；宿主端口 3307 避开本机原生 MySQL）
MYSQL_ROOT_PASSWORD=dev-root-123
MYSQL_DATABASE=viomanager
MYSQL_PORT=3307

# MinIO（本地开发默认值）
MINIO_ROOT_USER=vio-minio
MINIO_ROOT_PASSWORD=dev-minio-123
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=vio-minio
MINIO_SECRET_KEY=dev-minio-123

# JWT 密钥（本地开发可用默认值；生产必须改为强随机值，长度 ≥ 32 字节）
JWT_SECRET=viomanager-local-dev-secret-key-32bytes-minimum
