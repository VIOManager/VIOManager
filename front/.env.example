# VIOManager 前端环境变量样例（复制为 .env.development 使用；仓库仅入库本样例）
# 后端地址：Apifox Mock 或真实后端（联调时 VITE_USE_MOCK=false），切换只改此处，不改代码（方案 §2）
VITE_API_BASE_URL=http://localhost:8088

# 本地假数据开关：true=mock 层接管全部请求（不接后端）；false=走真实后端
VITE_USE_MOCK=true

# 论坛站地址（侧边栏"VIO 论坛"入口跳转目标）：独立站，JWT 与主站共享；开发期默认 5175
VITE_FORUM_URL=http://localhost:5175
