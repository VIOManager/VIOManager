# nginx 配置模板：官方镜像启动时把 ${BACKEND_ORIGIN} 替换为环境变量值；
# $uri / $host 等 nginx 自有变量不在环境变量里，不会被误替换
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # SPA 路由兜底：vue-router history 模式，直接访问/刷新非根路径不 404；
    # index.html 禁缓存（联调期容器频繁换版：旧页面引用的旧哈希资源已不存在，
    # 懒加载路由会 404 打不开页面——no-cache 让浏览器每次回源拿最新资源清单）
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # 知识库微服务（vio-kb 独立进程，默认宿主机 8091）；nginx 前缀取最长匹配，优先于 /api/
    location /api/kb/ {
        proxy_pass ${KB_ORIGIN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 210m;
    }

    # 接口同源反代到后端（默认宿主机 8088；全容器化部署时改成 compose 服务名）
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # 上传/下载走这条链路，包体上限对齐后端 multipart 25MB 加余量
        client_max_body_size 30m;
    }

    # vite 产物文件名带内容哈希，静态资源可放心长缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
